# Base URL of the digis_backend API.
# Dev: the Rails container is exposed on localhost:3000 (CORS is open, so
# cross-origin browser calls work without a proxy).
# Deployed: point at the hosted backend, e.g.
#   VITE_API_BASE_URL=https://digis-backend-preview.onrender.com
VITE_API_BASE_URL=http://localhost:3000

# Baked in at build time, so a deployed env var change requires a redeploy.
#
# NOTE: there is no mock fallback — the backend is the only source of truth
# (ADR-0002). A failed fetch surfaces through React Query (error state + retry),
# never fabricated data.
