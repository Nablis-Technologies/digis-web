# Base URL of the digis_backend API.
# Dev: the Rails container is exposed on localhost:3000 (CORS is open, so
# cross-origin browser calls work without a proxy).
VITE_API_BASE_URL=http://localhost:3000

# Backend-down handling:
#   true  → fall back to local mock data when the API is empty or errors
#           (dev/demo convenience — shows the UI even if Docker is down).
#   false → real API only; errors surface through React Query so the UI can
#           render an error state + retry (production behavior).
VITE_USE_MOCK=true
