# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
dist-ssr/
build/
*.local

# ---- Environment files ----
# Local env vars (secrets/config). Commit .env.example, never .env.
.env
.env.*
!.env.example

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
vite.log

# ---- Agent / tool dirs (installed skill repos, analysis caches) ----
.agents/
.ua/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Caches / temp ----
.vite/
.cache/
.temp/
*.tsbuildinfo
.nyc_output/
coverage/

# ---- TypeScript ----
# Compiled JS output that Vite generates alongside TS (safe to ignore)
# (Vite handles this itself; keep the toggle if you switch to tsc emits)
*.js.map
*.d.ts.map

# ---- Test artifacts (regenerated on every run) ----
test-results/
playwright-report/
e2e/.screenshots/
